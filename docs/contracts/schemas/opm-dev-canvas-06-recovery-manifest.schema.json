{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-recovery-manifest:0.1",
  "title": "OPM DEV-CANVAS-06 Recovery Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "manifest_version", "generated_at", "generator_identity", "handoff_ref", "intake_report_ref", "upstream_source_build", "source_build", "environment_policy", "fixture_catalog", "fault_policy", "case_catalog", "summary"],
  "properties": {"schema_id": {"const": "OPM-DEV-CANVAS-06-RECOVERY-MANIFEST-001"}, "schema_version": {"const": "0.1"}, "manifest_id": {"pattern": "^dev-canvas-06\\.recovery\\.[a-f0-9]{12}\\.[a-f0-9]{12}$"}, "manifest_version": {"const": "0.1.0"}, "generated_at": {"type": "string", "format": "date-time"}, "generator_identity": {"$ref": "#/$defs/identity"}, "handoff_ref": {"$ref": "#/$defs/fileRef"}, "intake_report_ref": {"$ref": "#/$defs/fileRef"}, "upstream_source_build": {"type": "object", "minProperties": 1}, "source_build": {"$ref": "#/$defs/sourceBuild"}, "environment_policy": {"$ref": "#/$defs/environmentPolicy"}, "fixture_catalog": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/fixture"}}, "fault_policy": {"$ref": "#/$defs/faultPolicy"}, "case_catalog": {"type": "array", "minItems": 28, "maxItems": 28, "items": {"$ref": "#/$defs/case"}}, "summary": {"$ref": "#/$defs/summary"}},
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["runner_version", "source_commit", "node_version", "os", "command", "runner_source_sha256"], "properties": {"runner_version": {"const": "0.1.0"}, "source_commit": {"pattern": "^[a-f0-9]{40}$"}, "node_version": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "runner_source_sha256": {"$ref": "#/$defs/digest"}}},
    "sourceBuild": {"type": "object", "additionalProperties": false, "required": ["source_commit", "dirty_before_build", "build_command", "node_version", "lockfile_sha256", "web_dist", "local_runtime_jar"], "properties": {"source_commit": {"pattern": "^[a-f0-9]{40}$"}, "dirty_before_build": {"const": false}, "build_command": {"type": "string", "minLength": 1}, "node_version": {"type": "string", "minLength": 1}, "lockfile_sha256": {"$ref": "#/$defs/digest"}, "web_dist": {"$ref": "#/$defs/fileRef"}, "local_runtime_jar": {"$ref": "#/$defs/fileRef"}}},
    "environmentPolicy": {"type": "object", "additionalProperties": false, "required": ["java_major", "node_major", "loopback_only", "production_gate_read_only"], "properties": {"java_major": {"const": 21}, "node_major": {"const": 22}, "loopback_only": {"const": true}, "production_gate_read_only": {"const": true}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "source_ref", "fixture_digest", "expected_result_digests"], "properties": {"fixture_id": {"enum": ["RECOVERY-FIXTURE-MODEL", "RECOVERY-FIXTURE-GATE"]}, "source_ref": {"$ref": "#/$defs/fileRef"}, "fixture_digest": {"$ref": "#/$defs/digest"}, "expected_result_digests": {"type": "object", "minProperties": 1}}},
    "faultPolicy": {"type": "object", "additionalProperties": false, "required": ["required_attempt_count", "runner_retry_count", "forced_termination", "evidence_capture_before_cleanup"], "properties": {"required_attempt_count": {"const": 2}, "runner_retry_count": {"const": 0}, "forced_termination": {"const": "OS_CHILD_PROCESS"}, "evidence_capture_before_cleanup": {"const": true}}},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["revision_delta", "revision_parent_delta", "text_artifact_delta", "text_trace_delta", "finding_delta", "operation_delta", "receipt_delta", "draft_head_changed"], "properties": {"revision_delta": {"type": "integer", "minimum": 0}, "revision_parent_delta": {"type": "integer", "minimum": 0}, "text_artifact_delta": {"type": "integer", "minimum": 0}, "text_trace_delta": {"type": "integer", "minimum": 0}, "finding_delta": {"type": "integer", "minimum": 0}, "operation_delta": {"type": "integer", "minimum": 0}, "receipt_delta": {"type": "integer", "minimum": 0}, "draft_head_changed": {"type": "boolean"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "category", "fixture_ref", "fault", "expected_process_outcome", "expected_transaction", "expected_reopen", "expected_gate", "required_attempt_count"], "properties": {"case_id": {"pattern": "^RCV-CANVAS-(0[0-2][0-9])\\.[A-Z0-9_]+$"}, "category": {"enum": ["PRE_COMMIT", "SQLITE", "FORCED_RESTART", "SERVICE_RECOVERY", "ROLLBACK"]}, "fixture_ref": {"$ref": "#/$defs/fileRef"}, "fault": {"type": "object", "additionalProperties": false, "required": ["stage", "variant", "requires_forced_termination"], "properties": {"stage": {"enum": ["PRE_COMMIT", "SQLITE", "FORCED_RESTART", "SERVICE_RECOVERY", "ROLLBACK"]}, "variant": {"type": "string", "minLength": 1}, "target_ref": {"$ref": "#/$defs/fileRef"}, "requires_forced_termination": {"type": "boolean"}}}, "expected_top_code": {"type": "string", "minLength": 1}, "expected_detail_code": {"type": "string", "minLength": 1}, "expected_process_outcome": {"enum": ["BLOCKED_ZERO_DELTA", "RESTART_ZERO_DELTA", "COMMITTED_RECOVERED", "STABLE_REOPEN", "ROLLBACK_PARTIAL", "ROLLBACK_FULL", "ROLLBACK_REJECTED"]}, "expected_transaction": {"$ref": "#/$defs/transaction"}, "expected_reopen": {"type": "object", "minProperties": 1}, "expected_gate": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["UNCHANGED_DISABLED", "PARTIAL", "FULL", "REJECTED"]}}}, "required_attempt_count": {"const": 2}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["fixture_count", "case_count", "pre_commit_case_count", "sqlite_case_count", "forced_restart_case_count", "service_recovery_case_count", "rollback_case_count", "required_attempt_count"], "properties": {"fixture_count": {"const": 2}, "case_count": {"const": 28}, "pre_commit_case_count": {"const": 8}, "sqlite_case_count": {"const": 7}, "forced_restart_case_count": {"const": 4}, "service_recovery_case_count": {"const": 3}, "rollback_case_count": {"const": 6}, "required_attempt_count": {"const": 56}}}
  }
}
