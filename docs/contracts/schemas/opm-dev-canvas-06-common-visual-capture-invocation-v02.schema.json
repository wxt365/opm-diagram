{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-common-visual-capture-invocation:0.2",
  "title": "OPM DEV-CANVAS-06 Common Visual Capture Callback Invocation v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "invocation_version", "request_id", "plan_ref", "common_capture_ordinal",
    "capture_id", "subject_id", "attempt_ordinal", "visual_variant_key", "viewport_id", "zoom_id",
    "fixture_ref", "project_id", "model_id", "context_id", "capture_setup", "expected_projection", "expected_projection_sha256", "expected_revision",
    "focus_target_id", "focus_anchor", "expected_cells", "critical_regions", "attempt_root", "storage_root",
    "runtime_base_url", "base_attestation_ref", "base_tree_sha256", "fault_mode"
  ],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-COMMON-VISUAL-CAPTURE-INVOCATION-001"},
    "schema_version": {"const": "0.2"},
    "invocation_version": {"const": "0.2.0"},
    "request_id": {"type": "string", "pattern": "^dev-canvas-06\\.common-visual-adapter\\.[A-Za-z0-9._-]+$"},
    "plan_ref": {"$ref": "#/$defs/fileRef"},
    "common_capture_ordinal": {"type": "integer", "minimum": 0, "maximum": 71},
    "capture_id": {"type": "string", "minLength": 1},
    "subject_id": {"$ref": "#/$defs/subject"},
    "attempt_ordinal": {"enum": [1, 2]},
    "visual_variant_key": {"type": "string", "minLength": 1},
    "viewport_id": {"enum": ["VP-1440X900", "VP-1280X800", "VP-390X844"]},
    "zoom_id": {"enum": ["Z-025", "Z-100", "Z-400"]},
    "fixture_ref": {"$ref": "#/$defs/fileRef"},
    "project_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "minLength": 1},
    "capture_setup": {"$ref": "urn:opm:contract:dev-canvas-06-common-visual-fixture:0.1#/$defs/captureSetup"},
    "expected_projection": {"$ref": "urn:opm:contract:dev-canvas-06-common-visual-fixture:0.1#/$defs/expectedProjection"},
    "expected_projection_sha256": {"$ref": "#/$defs/digest"},
    "expected_revision": {"type": "string", "minLength": 1},
    "focus_target_id": {"type": "string", "minLength": 1},
    "focus_anchor": {"enum": ["CENTER", "SOURCE", "TARGET", "LABEL", "JUNCTION"]},
    "expected_cells": {"type": "integer", "minimum": 1},
    "critical_regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criticalRegion"}},
    "attempt_root": {"$ref": "#/$defs/absolutePath"},
    "storage_root": {"$ref": "#/$defs/absolutePath"},
    "runtime_base_url": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"},
    "base_attestation_ref": {"$ref": "#/$defs/fileRef"},
    "base_tree_sha256": {"$ref": "#/$defs/digest"},
    "fault_mode": {"enum": ["NONE", "BLOCKED_FEEDBACK_ONE_SHOT"]}
  },
  "allOf": [
    {
      "if": {"properties": {"subject_id": {"const": "BLOCKED_FEEDBACK"}}, "required": ["subject_id"]},
      "then": {"properties": {"fault_mode": {"const": "BLOCKED_FEEDBACK_ONE_SHOT"}}},
      "else": {"properties": {"fault_mode": {"const": "NONE"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "logicalPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//).+$"},
    "subject": {"enum": ["STATE_ROLES", "LONG_LABELS", "FUNDAMENTAL_FAN", "CANDIDATE_LAYER", "INSPECTOR", "TOOLCHAIN_CATALOG", "FINDING_FOCUS", "BLOCKED_FEEDBACK"]},
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "byte_length", "sha256"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/logicalPath"}, "byte_length": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "criticalRegion": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "kind"],
      "properties": {"region_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["CANVAS", "INSPECTOR", "OPL", "FINDING", "FOCUS_BBOX", "SOURCE_MARKER", "TARGET_MARKER", "JUNCTION_MARKER", "ANNOTATION", "COMPLETENESS", "LABEL_SLOT"]}}
    }
  }
}
