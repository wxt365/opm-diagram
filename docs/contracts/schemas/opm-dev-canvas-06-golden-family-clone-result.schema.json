{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-golden-family-clone-result:0.1",
  "title": "OPM DEV-CANVAS-06 Golden Family Clone Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "result_version", "status", "capture_id", "attempt_ordinal", "source_date_epoch", "family_capture_identity_ref", "materialization_report_ref", "materialized_identity", "base_database_ref", "base_tree_sha256_before", "base_tree_sha256_after", "attempt_database_ref", "attempt_tree_sha256", "result_payload_sha256"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-GOLDEN-FAMILY-CLONE-RESULT-001"},
    "schema_version": {"const": "0.1"},
    "result_version": {"const": "0.1.0"},
    "status": {"const": "READY_FOR_RUNTIME"},
    "capture_id": {"type": "string", "minLength": 1},
    "attempt_ordinal": {"enum": [1, 2]},
    "source_date_epoch": {"type": "integer", "minimum": 0},
    "family_capture_identity_ref": {"allOf": [{"$ref": "#/$defs/fileRef"}, {"type": "object", "properties": {"kind": {"const": "FAMILY_CAPTURE_IDENTITY"}}}]},
    "materialization_report_ref": {"allOf": [{"$ref": "#/$defs/fileRef"}, {"type": "object", "properties": {"kind": {"const": "MATERIALIZATION_REPORT"}}}]},
    "materialized_identity": {"$ref": "#/$defs/materializedIdentity"},
    "base_database_ref": {"allOf": [{"$ref": "#/$defs/fileRef"}, {"type": "object", "properties": {"kind": {"const": "DATABASE"}}}]},
    "base_tree_sha256_before": {"$ref": "#/$defs/digest"},
    "base_tree_sha256_after": {"$ref": "#/$defs/digest"},
    "attempt_database_ref": {"allOf": [{"$ref": "#/$defs/fileRef"}, {"type": "object", "properties": {"kind": {"const": "PROJECT_DB"}}}]},
    "attempt_tree_sha256": {"$ref": "#/$defs/digest"},
    "result_payload_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "materializedIdentity": {"type": "object", "additionalProperties": false, "required": ["project_id", "model_id", "revision_id", "revision_sequence", "draft_head_revision_id", "head_sequence", "history_mode"], "properties": {"project_id": {"pattern": "^project\\.golden\\.fixture\\.[a-f0-9]{64}$"}, "model_id": {"type": "string", "minLength": 1}, "revision_id": {"type": "string", "minLength": 1}, "revision_sequence": {"type": "integer", "minimum": 1}, "draft_head_revision_id": {"type": "string", "minLength": 1}, "head_sequence": {"type": "integer", "minimum": 1}, "history_mode": {"const": "SINGLE_REVISION_SNAPSHOT"}}}
  }
}
