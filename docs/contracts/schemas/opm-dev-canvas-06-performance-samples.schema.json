{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-performance-samples:0.1",
  "title": "OPM DEV-CANVAS-06 Performance Raw Samples",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "sample_set_id", "generated_at", "manifest_ref", "scenario_id", "fixture_ref", "environment_fingerprint", "series", "integrity"],
  "properties": {"schema_id": {"const": "OPM-DEV-CANVAS-06-PERFORMANCE-SAMPLES-001"}, "schema_version": {"const": "0.1"}, "sample_set_id": {"pattern": "^dev-canvas-06\\.performance-samples\\.[a-f0-9]{12}$"}, "generated_at": {"type": "string", "format": "date-time"}, "manifest_ref": {"$ref": "#/$defs/fileRef"}, "scenario_id": {"$ref": "#/$defs/scenarioId"}, "fixture_ref": {"$ref": "#/$defs/fileRef"}, "environment_fingerprint": {"$ref": "#/$defs/digest"}, "series": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/series"}}, "integrity": {"$ref": "#/$defs/integrity"}},
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "scenarioId": {"enum": ["PERF-CANVAS-001.EDIT_FEEDBACK", "PERF-CANVAS-002.INCREMENTAL_OPL", "PERF-CANVAS-003.BASELINE_OPD", "PERF-CANVAS-004.STRESS_OPD", "PERF-CANVAS-005.LARGE_MODEL_SAVE", "PERF-CANVAS-006.LARGE_MODEL_SNAPSHOT", "PERF-CANVAS-007.LARGE_MODEL_VALIDATE"]},
    "sample": {"type": "object", "additionalProperties": false, "required": ["ordinal", "status", "started_at_monotonic_us", "ended_at_monotonic_us", "duration_us"], "properties": {"ordinal": {"type": "integer", "minimum": 1}, "status": {"enum": ["SUCCEEDED", "FAILED", "TIMEOUT", "OOM"]}, "started_at_monotonic_us": {"type": "integer", "minimum": 0}, "ended_at_monotonic_us": {"type": "integer", "minimum": 0}, "duration_us": {"type": "integer", "minimum": 0}, "result_ref": {"$ref": "#/$defs/fileRef"}, "failure_code": {"type": "string", "minLength": 1}}},
    "series": {"type": "object", "additionalProperties": false, "required": ["metric_id", "timing_domain", "unit", "measurement_method", "required_warmup_count", "observed_warmup_count", "observed_measured_count", "warmup_samples", "measured_samples", "series_digest"], "properties": {"metric_id": {"type": "string", "minLength": 1}, "timing_domain": {"enum": ["BROWSER_PERFORMANCE", "BROWSER_RAF", "NODE_HRTIME"]}, "unit": {"const": "MICROSECONDS"}, "measurement_method": {"type": "string", "minLength": 1}, "required_warmup_count": {"type": "integer", "minimum": 0}, "observed_warmup_count": {"type": "integer", "minimum": 0}, "required_measured_count": {"type": "integer", "minimum": 1}, "required_measured_duration_us": {"type": "integer", "minimum": 1}, "observed_measured_count": {"type": "integer", "minimum": 0}, "observed_measured_duration_us": {"type": "integer", "minimum": 0}, "warmup_samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}}, "measured_samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}}, "series_digest": {"$ref": "#/$defs/digest"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["status", "series_count", "sample_count", "ordinal_contiguous", "duplicate_count", "missing_count", "ordered_samples_sha256"], "properties": {"status": {"enum": ["MATCHED", "FAILED"]}, "series_count": {"type": "integer", "minimum": 1}, "sample_count": {"type": "integer", "minimum": 1}, "ordinal_contiguous": {"type": "boolean"}, "duplicate_count": {"type": "integer", "minimum": 0}, "missing_count": {"type": "integer", "minimum": 0}, "ordered_samples_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
