{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-intake-report:0.1",
  "title": "OPM DEV-CANVAS-06 Handoff Intake Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "report_id", "generated_at", "runner_identity", "handoff_ref", "intake_status", "checks", "capability_intake", "blockers"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-INTAKE-REPORT-001"},
    "schema_version": {"const": "0.1"},
    "report_id": {"pattern": "^dev-canvas-06\\.intake\\.[a-zA-Z0-9._-]+\\.[a-f0-9]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "runner_identity": {"$ref": "#/$defs/runnerIdentity"},
    "handoff_ref": {"$ref": "#/$defs/fileRef"},
    "intake_status": {"enum": ["BLOCKED", "READY_FOR_RELEASE_VALIDATION"]},
    "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/check"}},
    "capability_intake": {"type": "array", "maxItems": 34, "items": {"$ref": "#/$defs/capability"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}}
  },
  "allOf": [
    {"if": {"properties": {"intake_status": {"const": "READY_FOR_RELEASE_VALIDATION"}}}, "then": {"properties": {"checks": {"items": {"properties": {"status": {"const": "MATCHED"}}}}, "capability_intake": {"minItems": 34}, "blockers": {"maxItems": 0}}}},
    {"if": {"properties": {"intake_status": {"const": "BLOCKED"}}}, "then": {"properties": {"blockers": {"minItems": 1}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "runnerIdentity": {"type": "object", "additionalProperties": false, "required": ["runner_version", "source_commit", "node_version", "os", "command", "runner_source_sha256"], "properties": {"runner_version": {"const": "0.1.0"}, "source_commit": {"pattern": "^[a-f0-9]{40}$"}, "node_version": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "runner_source_sha256": {"$ref": "#/$defs/digest"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["check_id", "status", "evidence_refs", "observed_summary", "blocker_codes"], "properties": {"check_id": {"enum": ["INTAKE-06-001.HANDOFF_BYTES", "INTAKE-06-002.HANDOFF_SCHEMA_STATUS", "INTAKE-06-003.SOURCE_BUILD_ARTIFACTS", "INTAKE-06-004.REVISION_BINDINGS", "INTAKE-06-005.GATE_EVIDENCE", "INTAKE-06-006.COVERAGE_COMPATIBILITY", "INTAKE-06-007.CAPABILITY_ELIGIBILITY", "INTAKE-06-008.PRODUCTION_GATE_DISABLED"]}, "status": {"enum": ["MATCHED", "BLOCKED"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRef"}}, "observed_summary": {"type": "string", "minLength": 1}, "blocker_codes": {"type": "array", "items": {"type": "string", "pattern": "^CANVAS06_[A-Z0-9_]+$"}}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["capability_id", "family", "upstream_eligibility", "coverage_keys", "template_refs", "rule_refs", "symbol_refs", "grammar_refs", "binding_digest", "upstream_evidence_fingerprint", "intake_status", "blocker_codes"], "properties": {"capability_id": {"pattern": "^CAP-ISO-(PROC|CTRL|STRUCT)-\\d{3}$"}, "family": {"enum": ["PROCEDURAL", "CONTROL", "STRUCTURAL"]}, "upstream_eligibility": {"enum": ["ELIGIBLE_FOR_RELEASE_VALIDATION", "BLOCKED"]}, "coverage_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "template_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "rule_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "symbol_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "grammar_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}, "binding_digest": {"$ref": "#/$defs/digest"}, "upstream_evidence_fingerprint": {"$ref": "#/$defs/digest"}, "intake_status": {"enum": ["MATCHED", "BLOCKED"]}, "blocker_codes": {"type": "array", "items": {"type": "string", "pattern": "^CANVAS06_[A-Z0-9_]+$"}}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["code", "check_id", "evidence_refs", "message_key"], "properties": {"code": {"type": "string", "pattern": "^CANVAS06_[A-Z0-9_]+$"}, "check_id": {"type": "string", "minLength": 1}, "capability_id": {"pattern": "^CAP-ISO-(PROC|CTRL|STRUCT)-\\d{3}$"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRef"}}, "message_key": {"type": "string", "minLength": 1}}}
  }
}
