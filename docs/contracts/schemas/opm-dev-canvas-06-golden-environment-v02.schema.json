{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-golden-environment:0.2",
  "title": "OPM DEV-CANVAS-06 Golden Environment Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "environment_id", "generated_at", "os_name", "os_build", "arch", "playwright_version", "chromium_version", "browser_executable", "launch_args", "color_profile", "font_refs", "locale", "timezone", "color_scheme", "reduced_motion", "device_scale_factor", "screenshot_options", "environment_fingerprint", "png_refs", "blank_baseline_refs"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-GOLDEN-ENVIRONMENT-001"},
    "schema_version": {"const": "0.2"},
    "environment_id": {"pattern": "^dev-canvas-06\\.golden-environment\\.[a-f0-9]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "os_name": {"enum": ["darwin", "linux", "win32"]},
    "os_build": {"type": "string", "minLength": 1},
    "arch": {"enum": ["arm64", "x64"]},
    "playwright_version": {"const": "1.57.0"},
    "chromium_version": {"const": "143.0.7499.4"},
    "browser_executable": {"$ref": "#/$defs/browserExecutable"},
    "launch_args": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "contains": {"const": "--force-color-profile=srgb"}, "minContains": 1, "maxContains": 1},
    "color_profile": {"const": "sRGB IEC61966-2.1"},
    "font_refs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/fontRef"}},
    "locale": {"const": "zh-CN"},
    "timezone": {"const": "Asia/Shanghai"},
    "color_scheme": {"const": "light"},
    "reduced_motion": {"const": "reduce"},
    "device_scale_factor": {"const": 1},
    "screenshot_options": {"$ref": "#/$defs/screenshotOptions"},
    "environment_fingerprint": {"$ref": "#/$defs/digest"},
    "png_refs": {"type": "array", "minItems": 1242, "maxItems": 1242, "items": {"$ref": "#/$defs/pngRef"}},
    "blank_baseline_refs": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/baselineRef"}}
  },
  "allOf": [
    {"properties": {"font_refs": {"contains": {"properties": {"logical_role": {"const": "UI_SANS"}}, "required": ["logical_role"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"font_refs": {"contains": {"properties": {"logical_role": {"const": "CJK_FALLBACK"}}, "required": ["logical_role"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"font_refs": {"contains": {"properties": {"logical_role": {"const": "MONOSPACE"}}, "required": ["logical_role"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-1440X900.Z-025"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-1440X900.Z-100"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-1440X900.Z-400"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-1280X800.Z-025"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-1280X800.Z-100"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-1280X800.Z-400"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-390X844.Z-025"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-390X844.Z-100"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"blank_baseline_refs": {"contains": {"properties": {"baseline_id": {"const": "VP-390X844.Z-400"}}, "required": ["baseline_id"]}, "minContains": 1, "maxContains": 1}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "releasePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/releasePath"}, "byte_length": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "browserExecutable": {"type": "object", "additionalProperties": false, "required": ["realpath", "byte_length", "sha256"], "properties": {"realpath": {"type": "string", "minLength": 1}, "byte_length": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "fontRef": {"type": "object", "additionalProperties": false, "required": ["logical_role", "postscript_name", "font_version", "path", "byte_length", "sha256"], "properties": {"logical_role": {"enum": ["UI_SANS", "CJK_FALLBACK", "MONOSPACE"]}, "postscript_name": {"type": "string", "minLength": 1}, "font_version": {"type": "string", "minLength": 1}, "path": {"allOf": [{"$ref": "#/$defs/releasePath"}, {"pattern": "^environment/fonts/.+"}]}, "byte_length": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "screenshotOptions": {"type": "object", "additionalProperties": false, "required": ["animations", "caret", "scale", "mask_count"], "properties": {"animations": {"const": "disabled"}, "caret": {"const": "hide"}, "scale": {"const": "css"}, "mask_count": {"const": 0}}},
    "pngRef": {"type": "object", "additionalProperties": false, "required": ["capture_id", "ref"], "properties": {"capture_id": {"type": "string", "minLength": 1}, "ref": {"allOf": [{"$ref": "#/$defs/fileRef"}, {"properties": {"kind": {"const": "PNG"}, "path": {"pattern": "^(?!blank/).+\\.png$"}}}]}}},
    "baselineRef": {"type": "object", "additionalProperties": false, "required": ["baseline_id", "ref"], "properties": {"baseline_id": {"enum": ["VP-1440X900.Z-025", "VP-1440X900.Z-100", "VP-1440X900.Z-400", "VP-1280X800.Z-025", "VP-1280X800.Z-100", "VP-1280X800.Z-400", "VP-390X844.Z-025", "VP-390X844.Z-100", "VP-390X844.Z-400"]}, "ref": {"allOf": [{"$ref": "#/$defs/fileRef"}, {"properties": {"kind": {"const": "BLANK_PNG"}, "path": {"pattern": "^blank/[^/]+\\.png$"}}}]}}}
  }
}
