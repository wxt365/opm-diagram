{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-common-visual-adapter-test-input-bundle:0.1",
  "title": "OPM DEV-CANVAS-06 Common Visual Adapter Test Input Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "bundle_version", "bundle_id", "status", "source_commit",
    "source_date_epoch", "builder_source_ref", "verifier_source_ref", "java_executable_ref",
    "runtime_jar_source_ref", "runtime_jar_staged_ref", "profile_asset_tree_ref", "profile_asset_refs",
    "common_fixture_tree_ref", "common_catalog_ref", "capture_plan_ref", "common_capture_count",
    "callback_observed_results", "adapter_request_ref", "adapter_work_root", "bundle_payload_sha256"
  ],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-COMMON-VISUAL-ADAPTER-TEST-INPUT-BUNDLE-001"},
    "schema_version": {"const": "0.1"},
    "bundle_version": {"const": "0.1.0"},
    "bundle_id": {"type": "string", "pattern": "^dev-canvas-06\\.common-visual-adapter-test\\.[A-Za-z0-9._-]+$"},
    "status": {"const": "READY_FOR_ADAPTER_TEST"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_date_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "builder_source_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "ADAPTER_TEST_INPUT_BUILDER_SOURCE"}, "path": {"const": "scripts/build-canvas06-common-visual-adapter-test-input.mjs"}}}
      ]
    },
    "verifier_source_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "ADAPTER_TEST_INPUT_VERIFIER_SOURCE"}, "path": {"const": "scripts/verify-canvas06-common-visual-adapter-test-input.mjs"}}}
      ]
    },
    "java_executable_ref": {"$ref": "#/$defs/javaExecutableRef"},
    "runtime_jar_source_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "LOCAL_RUNTIME_JAR"}}}
      ]
    },
    "runtime_jar_staged_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "RUNTIME_JAR"}, "path": {"const": "inputs/build/local-runtime.jar"}}}
      ]
    },
    "profile_asset_tree_ref": {"$ref": "#/$defs/profileAssetTreeRef"},
    "profile_asset_refs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/grammarAssetRef"},
        {"$ref": "#/$defs/normalizationDataRef"},
        {"$ref": "#/$defs/profilePackageRef"},
        {"$ref": "#/$defs/ruleSetRef"},
        {"$ref": "#/$defs/symbolAssetRef"}
      ],
      "items": false
    },
    "common_fixture_tree_ref": {"$ref": "#/$defs/commonTreeRef"},
    "common_catalog_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "COMMON_FIXTURE_CATALOG"}, "path": {"const": "inputs/common/dev-canvas-06-common-fixture-catalog.json"}}}
      ]
    },
    "capture_plan_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "CAPTURE_PLAN"}, "path": {"const": "inputs/golden/capture-plan.json"}}}
      ]
    },
    "common_capture_count": {"const": 72},
    "callback_observed_results": {
      "type": "array",
      "minItems": 144,
      "maxItems": 144,
      "items": {"$ref": "#/$defs/callbackObservedResult"}
    },
    "adapter_request_ref": {
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"type": "object", "properties": {"kind": {"const": "ADAPTER_REQUEST"}, "path": {"const": "adapter-request.json"}}}
      ]
    },
    "adapter_work_root": {"$ref": "#/$defs/absolutePath"},
    "bundle_payload_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "logicalPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//).+$"},
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "byte_length", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/logicalPath"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "javaExecutableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "byte_length", "sha256"],
      "properties": {
        "kind": {"const": "JAVA_EXECUTABLE"},
        "path": {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/bin/java$"}]},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "profileAssetTreeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "byte_length", "sha256"],
      "properties": {
        "kind": {"const": "PROFILE_ASSET_TREE"},
        "path": {"const": "profile/assets"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "profileAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "byte_length", "sha256"],
      "properties": {
        "kind": {"enum": ["PROFILE_PACKAGE", "RULE_SET", "SYMBOL_ASSET", "GRAMMAR_ASSET", "NORMALIZATION_DATA"]},
        "path": {"$ref": "#/$defs/logicalPath"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "grammarAssetRef": {"allOf": [{"$ref": "#/$defs/profileAssetRef"}, {"type": "object", "properties": {"kind": {"const": "GRAMMAR_ASSET"}, "path": {"const": "profile/assets/grammar/representative-opl-grammar.json"}}}]},
    "normalizationDataRef": {"allOf": [{"$ref": "#/$defs/profileAssetRef"}, {"type": "object", "properties": {"kind": {"const": "NORMALIZATION_DATA"}, "path": {"const": "profile/assets/normalization/representative-normalization.json"}}}]},
    "profilePackageRef": {"allOf": [{"$ref": "#/$defs/profileAssetRef"}, {"type": "object", "properties": {"kind": {"const": "PROFILE_PACKAGE"}, "path": {"const": "profile/assets/profile.json"}}}]},
    "ruleSetRef": {"allOf": [{"$ref": "#/$defs/profileAssetRef"}, {"type": "object", "properties": {"kind": {"const": "RULE_SET"}, "path": {"const": "profile/assets/rules/representative-rule-set.json"}}}]},
    "symbolAssetRef": {"allOf": [{"$ref": "#/$defs/profileAssetRef"}, {"type": "object", "properties": {"kind": {"const": "SYMBOL_ASSET"}, "path": {"const": "profile/assets/symbols/representative-symbol-catalog.json"}}}]},
    "commonTreeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "file_count", "byte_length", "sha256"],
      "properties": {
        "kind": {"const": "COMMON_FIXTURE_TREE"},
        "path": {"const": "inputs/common"},
        "file_count": {"const": 44},
        "byte_length": {"type": "integer", "minimum": 44, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "subject": {"enum": ["STATE_ROLES", "LONG_LABELS", "FUNDAMENTAL_FAN", "CANDIDATE_LAYER", "INSPECTOR", "TOOLCHAIN_CATALOG", "FINDING_FOCUS", "BLOCKED_FEEDBACK"]},
    "callbackObservedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_capture_ordinal", "capture_id", "subject_id", "attempt_ordinal", "observed_result_ref", "png_ref"],
      "properties": {
        "common_capture_ordinal": {"type": "integer", "minimum": 0, "maximum": 71},
        "capture_id": {"type": "string", "minLength": 1},
        "subject_id": {"$ref": "#/$defs/subject"},
        "attempt_ordinal": {"enum": [1, 2]},
        "observed_result_ref": {
          "allOf": [
            {"$ref": "#/$defs/fileRef"},
            {"type": "object", "properties": {"kind": {"const": "CAPTURE_OBSERVED_RESULT"}, "path": {"type": "string", "pattern": "^callback-results/[0-9]{3}/attempt-[12]/observed-result\\.json$"}}}
          ]
        },
        "png_ref": {
          "allOf": [
            {"$ref": "#/$defs/fileRef"},
            {"type": "object", "properties": {"kind": {"const": "TEST_CALLBACK_PNG"}, "path": {"type": "string", "pattern": "^callback-results/[0-9]{3}/attempt-[12]/capture\\.png$"}}}
          ]
        }
      }
    }
  }
}
