{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-golden-approval-record:0.1",
  "title": "OPM DEV-CANVAS-06 Golden Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_id", "record_version", "change_id", "mode", "golden_set_version", "requested_at", "approved_at", "source_date_epoch", "applicant", "approver", "reason_code", "reason_text", "external_refs", "capture_plan_ref", "capture_set_sha256", "environment_fingerprint", "source_build_digest", "runtime_jar_ref", "web_dist_tree_sha256", "candidate_content_sha256", "old_golden_set_version", "old_golden_set_sha256", "predecessor_authoring_report_ref", "new_golden_set_sha256", "approved_output_path", "approval_status", "approval_payload_sha256"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-GOLDEN-APPROVAL-RECORD-001"}, "schema_version": {"const": "0.1"}, "record_id": {"pattern": "^dev-canvas-06\\.golden-approval\\.GOLDEN-CANVAS06-[0-9]{8}-[0-9]{3}$"}, "record_version": {"const": "0.1.0"}, "change_id": {"pattern": "^GOLDEN-CANVAS06-[0-9]{8}-[0-9]{3}$"}, "mode": {"enum": ["INITIAL", "SUPERSEDE"]}, "golden_set_version": {"$ref": "#/$defs/semver"}, "requested_at": {"type": "string", "format": "date-time"}, "approved_at": {"type": "string", "format": "date-time"}, "source_date_epoch": {"type": "integer", "minimum": 0}, "applicant": {"$ref": "#/$defs/person"}, "approver": {"$ref": "#/$defs/person"}, "reason_code": {"enum": ["INITIAL_BASELINE", "EXPECTED_VISUAL_CHANGE", "BROWSER_TOOLCHAIN_CHANGE", "FONT_CHANGE", "OS_CHANGE", "FIXTURE_CHANGE", "BUG_FIX", "DESIGN_CHANGE"]}, "reason_text": {"type": "string", "minLength": 1}, "external_refs": {"type": "array", "items": {"$ref": "#/$defs/externalRef"}}, "capture_plan_ref": {"$ref": "#/$defs/fileRef"}, "capture_set_sha256": {"$ref": "#/$defs/digest"}, "environment_fingerprint": {"$ref": "#/$defs/digest"}, "source_build_digest": {"$ref": "#/$defs/digest"}, "runtime_jar_ref": {"$ref": "#/$defs/fileRef"}, "web_dist_tree_sha256": {"$ref": "#/$defs/digest"}, "candidate_content_sha256": {"$ref": "#/$defs/digest"}, "old_golden_set_version": {"anyOf": [{"$ref": "#/$defs/semver"}, {"type": "null"}]}, "old_golden_set_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "predecessor_authoring_report_ref": {"anyOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]}, "new_golden_set_sha256": {"$ref": "#/$defs/digest"}, "approved_output_path": {"pattern": "^versions/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "approval_status": {"const": "APPROVED"}, "approval_payload_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "INITIAL"}}}, "then": {"properties": {"golden_set_version": {"const": "1.0.0"}, "reason_code": {"const": "INITIAL_BASELINE"}, "old_golden_set_version": {"type": "null"}, "old_golden_set_sha256": {"type": "null"}, "predecessor_authoring_report_ref": {"type": "null"}, "approved_output_path": {"const": "versions/1.0.0"}}}},
    {"if": {"properties": {"mode": {"const": "SUPERSEDE"}}}, "then": {"required": ["old_golden_set_version", "old_golden_set_sha256", "predecessor_authoring_report_ref"], "properties": {"old_golden_set_version": {"$ref": "#/$defs/semver"}, "old_golden_set_sha256": {"$ref": "#/$defs/digest"}, "predecessor_authoring_report_ref": {"$ref": "#/$defs/fileRef"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"}, "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}}, "person": {"type": "object", "additionalProperties": false, "required": ["id", "display_name"], "properties": {"id": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}}}, "externalRef": {"type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": {"kind": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}}}
  }
}
