{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-e2e-family-fixture-identity-catalog:0.1",
  "title": "OPM DEV-CANVAS-06 E2E Family Fixture Identity Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalog_id",
    "catalog_version",
    "source_profile",
    "source_golden_manifest_sha256",
    "entries",
    "summary",
    "catalog_payload_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "OPM-DEV-CANVAS-06-E2E-FAMILY-FIXTURE-IDENTITY-CATALOG-001"
    },
    "schema_version": {
      "const": "0.1"
    },
    "catalog_id": {
      "const": "dev-canvas-06.e2e-family-fixture-identity.iso19450.2024.draft"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_profile": {
      "$ref": "#/$defs/sourceProfile"
    },
    "source_golden_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "catalog_payload_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_sha256",
        "project_id",
        "model_id",
        "context_id",
        "base_revision",
        "revision_sequence",
        "parent_revision_id"
      ],
      "properties": {
        "fixture_sha256": {
          "$ref": "#/$defs/digest"
        },
        "project_id": {
          "type": "string",
          "pattern": "^project\\.e2e\\.family\\.[a-z0-9.-]+$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "parent_revision_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_case_count", "distinct_base_fixture_count"],
      "properties": {
        "family_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "distinct_base_fixture_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
