    {"if": {"properties": {"report_status": {"const": "APPROVED_PUBLISHED"}}}, "then": {"required": ["approval_record_ref", "golden_environment_ref"], "properties": {"failures": {"maxItems": 0}, "capture_summary": {"properties": {"capture_count": {"const": 1242}, "blank_baseline_count": {"const": 9}, "capture_attempt_count": {"const": 2484}, "blank_attempt_count": {"const": 18}, "deterministic": {"const": true}}}, "approved_assets": {"properties": {"png_refs": {"minItems": 1242}, "blank_baseline_refs": {"minItems": 9}, "font_refs": {"minItems": 1}}}}}},
    {"if": {"properties": {"report_status": {"const": "BLOCKED"}}}, "then": {"properties": {"failures": {"minItems": 1}}, "not": {"anyOf": [{"required": ["approval_record_ref"]}, {"required": ["golden_environment_ref"]}]}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"}, "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}}, "identity": {"type": "object", "additionalProperties": false, "required": ["runner_version", "source_commit", "node_version", "command", "runner_source_sha256"], "properties": {"runner_version": {"const": "0.1.0"}, "source_commit": {"pattern": "^[a-f0-9]{40}$"}, "node_version": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "runner_source_sha256": {"$ref": "#/$defs/digest"}}}, "sourceBuild": {"type": "object", "additionalProperties": false, "required": ["source_commit", "dirty_before_build", "node_full_version", "node_executable_sha256", "npm_version", "lockfile_sha256", "build_command", "web_dist_tree_sha256", "runtime_jar_sha256"], "properties": {"source_commit": {"pattern": "^[a-f0-9]{40}$"}, "dirty_before_build": {"const": false}, "node_full_version": {"type": "string", "minLength": 1}, "node_executable_sha256": {"$ref": "#/$defs/digest"}, "npm_version": {"const": "10.9.4"}, "lockfile_sha256": {"$ref": "#/$defs/digest"}, "build_command": {"const": "npm ci --ignore-scripts && npm run build"}, "web_dist_tree_sha256": {"$ref": "#/$defs/digest"}, "runtime_jar_sha256": {"$ref": "#/$defs/digest"}}}, "materialization": {"type": "object", "additionalProperties": false, "required": ["bundle_ref", "java_version", "entry_allowlist", "materialized_count", "aggregate_sha256", "temporary_directory_cleaned"], "properties": {"bundle_ref": {"$ref": "#/$defs/fileRef"}, "java_version": {"type": "string", "minLength": 1}, "entry_allowlist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}, "materialized_count": {"type": "integer", "minimum": 1}, "aggregate_sha256": {"$ref": "#/$defs/digest"}, "temporary_directory_cleaned": {"const": true}}}, "environment": {"type": "object", "additionalProperties": false, "required": ["environment_fingerprint", "locale", "timezone", "color_scheme", "reduced_motion", "device_scale_factor"], "properties": {"environment_fingerprint": {"$ref": "#/$defs/digest"}, "locale": {"const": "zh-CN"}, "timezone": {"const": "Asia/Shanghai"}, "color_scheme": {"const": "light"}, "reduced_motion": {"const": "reduce"}, "device_scale_factor": {"const": 1}}}, "captureSummary": {"type": "object", "additionalProperties": false, "required": ["capture_count", "blank_baseline_count", "capture_attempt_count", "blank_attempt_count", "deterministic"], "properties": {"capture_count": {"type": "integer", "minimum": 0, "maximum": 1242}, "blank_baseline_count": {"type": "integer", "minimum": 0, "maximum": 9}, "capture_attempt_count": {"type": "integer", "minimum": 0, "maximum": 2484}, "blank_attempt_count": {"type": "integer", "minimum": 0, "maximum": 18}, "deterministic": {"type": "boolean"}}}, "assetRef": {"type": "object", "additionalProperties": false, "required": ["logical_id", "path", "byte_length", "sha256"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}}, "approvedAssets": {"type": "object", "additionalProperties": false, "required": ["png_refs", "blank_baseline_refs", "font_refs"], "properties": {"png_refs": {"type": "array", "minItems": 0, "maxItems": 1242, "items": {"$ref": "#/$defs/assetRef"}}, "blank_baseline_refs": {"type": "array", "minItems": 0, "maxItems": 9, "items": {"$ref": "#/$defs/assetRef"}}, "font_refs": {"type": "array", "minItems": 0, "items": {"$ref": "#/$defs/assetRef"}}}}, "failure": {"type": "object", "additionalProperties": false, "required": ["code", "message_key"], "properties": {"code": {"type": "string", "minLength": 1}, "message_key": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/fileRef"}}}}
  }
}
