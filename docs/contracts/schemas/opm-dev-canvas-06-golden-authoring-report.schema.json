  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-GOLDEN-AUTHORING-REPORT-001"}, "schema_version": {"const": "0.1"}, "report_id": {"pattern": "^dev-canvas-06\\.golden-authoring-report\\.GOLDEN-CANVAS06-[0-9]{8}-[0-9]{3}$"}, "report_version": {"const": "0.1.0"}, "report_status": {"enum": ["READY_FOR_APPROVAL", "APPROVED_PUBLISHED", "BLOCKED"]}, "change_id": {"pattern": "^GOLDEN-CANVAS06-[0-9]{8}-[0-9]{3}$"}, "generated_at": {"type": "string", "format": "date-time"}, "source_date_epoch": {"type": "integer", "minimum": 0}, "generator_identity": {"$ref": "#/$defs/identity"}, "capture_plan_ref": {"$ref": "#/$defs/fileRef"}, "approval_record_ref": {"$ref": "#/$defs/fileRef"}, "handoff_ref": {"$ref": "#/$defs/fileRef"}, "intake_report_ref": {"$ref": "#/$defs/fileRef"}, "source_build": {"$ref": "#/$defs/sourceBuild"}, "source_build_digest": {"$ref": "#/$defs/digest"}, "runtime_jar_ref": {"$ref": "#/$defs/fileRef"}, "web_dist_tree_sha256": {"$ref": "#/$defs/digest"}, "input_materialization": {"$ref": "#/$defs/materialization"}, "environment": {"$ref": "#/$defs/environment"}, "golden_environment_ref": {"$ref": "#/$defs/fileRef"}, "capture_summary": {"$ref": "#/$defs/captureSummary"}, "approved_assets": {"$ref": "#/$defs/approvedAssets"}, "old_golden_set_version": {"anyOf": [{"$ref": "#/$defs/semver"}, {"type": "null"}]}, "old_golden_set_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "new_golden_set_sha256": {"$ref": "#/$defs/digest"}, "golden_set_version": {"$ref": "#/$defs/semver"}, "command": {"type": "string", "minLength": 1}, "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}}
  },
  "allOf": [
