{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-common-visual-adapter-normalized-result:0.1",
  "title": "OPM DEV-CANVAS-06 Common Visual Adapter Normalized Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "result_version", "status", "request_id", "plan_ref", "catalog_ref",
    "runtime_jar_ref", "source_date_epoch", "base_results", "attempt_results", "base_set_sha256",
    "attempt_set_sha256", "summary", "result_payload_sha256"
  ],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-COMMON-VISUAL-ADAPTER-NORMALIZED-RESULT-001"},
    "schema_version": {"const": "0.1"},
    "result_version": {"const": "0.1.0"},
    "status": {"const": "READY_FOR_CANDIDATE_TRANSACTION"},
    "request_id": {"type": "string", "pattern": "^dev-canvas-06\\.common-visual-adapter\\.[A-Za-z0-9._-]+$"},
    "plan_ref": {"$ref": "#/$defs/fileRef"},
    "catalog_ref": {"$ref": "#/$defs/fileRef"},
    "runtime_jar_ref": {"$ref": "#/$defs/fileRef"},
    "source_date_epoch": {"type": "integer", "minimum": 0},
    "base_results": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/baseResult"}},
    "attempt_results": {"type": "array", "minItems": 144, "maxItems": 144, "items": {"$ref": "#/$defs/attemptResult"}},
    "base_set_sha256": {"$ref": "#/$defs/digest"},
    "attempt_set_sha256": {"$ref": "#/$defs/digest"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_count", "base_count", "common_capture_count", "attempt_count", "deterministic"],
      "properties": {"subject_count": {"const": 8}, "base_count": {"const": 8}, "common_capture_count": {"const": 72}, "attempt_count": {"const": 144}, "deterministic": {"const": true}}
    },
    "result_payload_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "logicalPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "subject": {"enum": ["STATE_ROLES", "LONG_LABELS", "FUNDAMENTAL_FAN", "CANDIDATE_LAYER", "INSPECTOR", "TOOLCHAIN_CATALOG", "FINDING_FOCUS", "BLOCKED_FEEDBACK"]},
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "byte_length", "sha256"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/logicalPath"}, "byte_length": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "baseResult": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "fixture_ref", "attestation_ref", "database_ref", "semantic_state_sha256", "committed_projection_sha256", "base_tree_sha256", "base_read_only"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/subject"}, "fixture_ref": {"$ref": "#/$defs/fileRef"}, "attestation_ref": {"$ref": "#/$defs/fileRef"},
        "database_ref": {"$ref": "#/$defs/fileRef"}, "semantic_state_sha256": {"$ref": "#/$defs/digest"}, "committed_projection_sha256": {"$ref": "#/$defs/digest"},
        "base_tree_sha256": {"$ref": "#/$defs/digest"}, "base_read_only": {"const": true}
      }
    },
    "attemptResult": {
      "type": "object", "additionalProperties": false,
      "required": ["common_capture_ordinal", "capture_id", "subject_id", "attempt_ordinal", "attempt_storage_ref", "attempt_tree_sha256", "base_tree_sha256_before", "base_tree_sha256_after", "runtime_shutdown_status", "observed"],
      "properties": {
        "common_capture_ordinal": {"type": "integer", "minimum": 0, "maximum": 71},
        "capture_id": {"type": "string", "minLength": 1},
        "subject_id": {"$ref": "#/$defs/subject"},
        "attempt_ordinal": {"enum": [1, 2]},
        "attempt_storage_ref": {"$ref": "#/$defs/fileRef"},
        "attempt_tree_sha256": {"$ref": "#/$defs/digest"},
        "base_tree_sha256_before": {"$ref": "#/$defs/digest"},
        "base_tree_sha256_after": {"$ref": "#/$defs/digest"},
        "runtime_shutdown_status": {"const": "CLOSED"},
        "observed": {"$ref": "urn:opm:contract:dev-canvas-06-common-visual-capture-observed-result:0.1"}
      }
    }
  }
}
