            "DRIVER-PROCEDURAL",
            "DRIVER-CONTROL",
            "DRIVER-STRUCTURAL",
            "DRIVER-COMMON"
          ]
        },
        "expected_transaction": {
          "$ref": "#/$defs/transaction"
