          "type": "integer",
          "minimum": 0
        },
        "text_artifact_delta": {
          "type": "integer",
          "minimum": 0
        },
        "text_trace_delta": {
          "type": "integer",
          "minimum": 0
        },
        "finding_delta": {
          "type": "integer",
          "minimum": 0
        },
        "operation_delta": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_delta": {
          "type": "integer",
          "minimum": 0
        },
        "draft_head_changed": {
