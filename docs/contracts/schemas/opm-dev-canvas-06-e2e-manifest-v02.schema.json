    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "suite_id",
        "expectation",
        "viewport_id",
        "zoom_id",
        "fixture_ref",
        "input_ref",
        "driver_id",
        "expected_transaction",
        "assertion_ids"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_id": {
          "enum": [
            "E2E-CANVAS-001",
            "E2E-CANVAS-002",
            "E2E-CANVAS-003",
            "E2E-CANVAS-004",
            "E2E-CANVAS-005",
            "E2E-CANVAS-006",
            "E2E-CANVAS-007"
          ]
        },
        "capability_id": {
          "pattern": "^CAP-ISO-(PROC|CTRL|STRUCT)-\\d{3}$"
        },
        "coverage_key": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "viewport_id": {
          "enum": [
            "VP-1440X900",
            "VP-1280X800",
            "VP-390X844"
          ]
        },
        "zoom_id": {
          "const": "Z-100"
