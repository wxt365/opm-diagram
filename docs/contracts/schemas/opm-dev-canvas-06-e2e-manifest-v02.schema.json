          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "capability_id"
            ]
          },
          "then": {
            "required": [
              "coverage_key"
            ],
            "properties": {
              "suite_id": {
                "enum": [
                  "E2E-CANVAS-002",
                  "E2E-CANVAS-003",
                  "E2E-CANVAS-004"
                ]
              },
              "driver_id": {
                "enum": [
                  "DRIVER-PROCEDURAL",
                  "DRIVER-CONTROL",
                  "DRIVER-STRUCTURAL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "capability_id"
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "coverage_key"
              ]
            },
            "properties": {
              "suite_id": {
                "enum": [
                  "E2E-CANVAS-001",
                  "E2E-CANVAS-005",
                  "E2E-CANVAS-006",
                  "E2E-CANVAS-007"
                ]
              },
              "driver_id": {
                "const": "DRIVER-COMMON"
              }
            }
          }
        }
      ]
