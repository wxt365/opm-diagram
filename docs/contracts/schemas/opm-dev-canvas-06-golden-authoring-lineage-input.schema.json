{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-golden-authoring-lineage-input:0.1",
  "title": "OPM DEV-CANVAS-06 Golden Authoring Lineage Input 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "lineage_version", "lineage_id", "mode", "golden_set_version", "old_golden_set_version", "old_golden_set_sha256"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-GOLDEN-AUTHORING-LINEAGE-INPUT-001"},
    "schema_version": {"const": "0.1"},
    "lineage_version": {"const": "0.1.0"},
    "lineage_id": {"pattern": "^dev-canvas-06\\.golden-authoring-lineage\\.GOLDEN-CANVAS06-[0-9]{8}-[0-9]{3}$"},
    "mode": {"enum": ["INITIAL", "SUPERSEDE"]},
    "golden_set_version": {"$ref": "#/$defs/semver"},
    "old_golden_set_version": {"anyOf": [{"$ref": "#/$defs/semver"}, {"type": "null"}]},
    "old_golden_set_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "INITIAL"}}},
      "then": {"properties": {"golden_set_version": {"const": "1.0.0"}, "old_golden_set_version": {"type": "null"}, "old_golden_set_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "SUPERSEDE"}}},
      "then": {"properties": {"old_golden_set_version": {"$ref": "#/$defs/semver"}, "old_golden_set_sha256": {"$ref": "#/$defs/digest"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
