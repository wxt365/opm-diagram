    "upstreamBuild": {"type": "object", "additionalProperties": false, "required": ["source_commit", "dirty_before_build", "evidence_output_root", "java_version", "node_version", "os", "build_command", "lockfile_sha256", "pom_sha256"], "properties": {"source_commit": {"pattern": "^[a-f0-9]{40}$"}, "dirty_before_build": {"const": false}, "evidence_output_root": {"$ref": "#/$defs/path"}, "java_version": {"type": "string", "minLength": 1}, "node_version": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "build_command": {"type": "string", "minLength": 1}, "lockfile_sha256": {"$ref": "#/$defs/digest"}, "pom_sha256": {"$ref": "#/$defs/digest"}}},
    "sourceBuild": {"type": "object", "additionalProperties": false, "required": ["source_commit", "dirty_before_build", "build_command", "node_version", "lockfile_sha256", "web_dist", "local_runtime_jar"], "properties": {"source_commit": {"pattern": "^[a-f0-9]{40}$"}, "dirty_before_build": {"const": false}, "build_command": {"type": "string", "minLength": 1}, "node_version": {"type": "string", "minLength": 1}, "lockfile_sha256": {"$ref": "#/$defs/digest"}, "web_dist": {"$ref": "#/$defs/fileRef"}, "local_runtime_jar": {"$ref": "#/$defs/fileRef"}}},
    "upstreamInputs": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"allOf": [{"$ref": "#/$defs/inputItem"}, {"properties": {"input_kind": {"const": "COVERAGE_CATALOG"}}}]}, {"allOf": [{"$ref": "#/$defs/inputItem"}, {"properties": {"input_kind": {"const": "GOLDEN_MANIFEST"}}}]}, {"allOf": [{"$ref": "#/$defs/inputItem"}, {"properties": {"input_kind": {"const": "GOLDEN_REPLAY_REPORT"}}}]}, {"allOf": [{"$ref": "#/$defs/inputItem"}, {"properties": {"input_kind": {"const": "SYMBOL_CATALOG"}}}]}, {"allOf": [{"$ref": "#/$defs/inputItem"}, {"properties": {"input_kind": {"const": "HANDOFF_EVIDENCE_BUNDLE"}}}]}], "items": false},
    "inputItem": {"type": "object", "additionalProperties": false, "required": ["input_kind", "ref"], "properties": {"input_kind": {"enum": ["COVERAGE_CATALOG", "GOLDEN_MANIFEST", "GOLDEN_REPLAY_REPORT", "SYMBOL_CATALOG", "HANDOFF_EVIDENCE_BUNDLE"]}, "ref": {"$ref": "#/$defs/inputRef"}}},
    "inputMaterialization": {"type": "object", "additionalProperties": false, "required": ["bundle_ref", "java_version", "entry_allowlist", "materialized_count", "aggregate_sha256", "temporary_directory_cleaned"], "properties": {"bundle_ref": {"$ref": "#/$defs/fileRef"}, "java_version": {"type": "string", "minLength": 1}, "entry_allowlist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}, "materialized_count": {"type": "integer", "minimum": 1}, "aggregate_sha256": {"$ref": "#/$defs/digest"}, "temporary_directory_cleaned": {"const": true}}},
    "environmentPolicy": {"type": "object", "additionalProperties": false, "required": ["locale", "timezone", "color_scheme", "reduced_motion", "device_scale_factor"], "properties": {"locale": {"const": "zh-CN"}, "timezone": {"const": "Asia/Shanghai"}, "color_scheme": {"const": "light"}, "reduced_motion": {"const": "reduce"}, "device_scale_factor": {"const": 1}}},
    "viewports": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/vp1440"}, {"$ref": "#/$defs/vp1280"}, {"$ref": "#/$defs/vp390"}], "items": false},
    "vp1440": {"type": "object", "additionalProperties": false, "required": ["viewport_id", "width", "height", "device_scale_factor"], "properties": {"viewport_id": {"const": "VP-1440X900"}, "width": {"const": 1440}, "height": {"const": 900}, "device_scale_factor": {"const": 1}}},
    "vp1280": {"type": "object", "additionalProperties": false, "required": ["viewport_id", "width", "height", "device_scale_factor"], "properties": {"viewport_id": {"const": "VP-1280X800"}, "width": {"const": 1280}, "height": {"const": 800}, "device_scale_factor": {"const": 1}}},
    "vp390": {"type": "object", "additionalProperties": false, "required": ["viewport_id", "width", "height", "device_scale_factor"], "properties": {"viewport_id": {"const": "VP-390X844"}, "width": {"const": 390}, "height": {"const": 844}, "device_scale_factor": {"const": 1}}},
    "zooms": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "object", "additionalProperties": false, "required": ["zoom_id", "scale"], "properties": {"zoom_id": {"const": "Z-025"}, "scale": {"const": 0.25}}}, {"type": "object", "additionalProperties": false, "required": ["zoom_id", "scale"], "properties": {"zoom_id": {"const": "Z-100"}, "scale": {"const": 1}}}, {"type": "object", "additionalProperties": false, "required": ["zoom_id", "scale"], "properties": {"zoom_id": {"const": "Z-400"}, "scale": {"const": 4}}}], "items": false},
    "commonSubjects": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"enum": ["STATE_ROLES", "LONG_LABELS", "FUNDAMENTAL_FAN", "CANDIDATE_LAYER", "INSPECTOR", "TOOLCHAIN_CATALOG", "FINDING_FOCUS", "BLOCKED_FEEDBACK"]}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version"], "properties": {"policy_id": {"type": "string", "minLength": 1}, "policy_version": {"const": "0.1"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "case_kind", "viewport_id", "zoom_id", "variant_captures"], "properties": {"case_id": {"type": "string", "minLength": 1}, "case_kind": {"enum": ["CAPABILITY", "COMMON"]}, "capability_id": {"pattern": "^CAP-ISO-(PROC|CTRL|STRUCT)-\\d{3}$"}, "subject_id": {"enum": ["STATE_ROLES", "LONG_LABELS", "FUNDAMENTAL_FAN", "CANDIDATE_LAYER", "INSPECTOR", "TOOLCHAIN_CATALOG", "FINDING_FOCUS", "BLOCKED_FEEDBACK"]}, "viewport_id": {"enum": ["VP-1440X900", "VP-1280X800", "VP-390X844"]}, "zoom_id": {"enum": ["Z-025", "Z-100", "Z-400"]}, "variant_captures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capture"}}}, "allOf": [{"if": {"properties": {"case_kind": {"const": "CAPABILITY"}}}, "then": {"required": ["capability_id"], "not": {"required": ["subject_id"]}}}, {"if": {"properties": {"case_kind": {"const": "COMMON"}}}, "then": {"required": ["subject_id"], "not": {"required": ["capability_id"]}}}]},
    "capture": {"type": "object", "additionalProperties": false, "required": ["visual_variant_key", "capture_id", "fixture_ref", "expected_revision", "focus_target_id", "focus_anchor", "expected_cells", "golden_ref", "critical_regions", "expected_projection_sha256"], "properties": {"visual_variant_key": {"type": "string", "minLength": 1}, "capture_id": {"type": "string", "minLength": 1}, "fixture_ref": {"$ref": "#/$defs/inputRef"}, "expected_revision": {"type": "string", "minLength": 1}, "focus_target_id": {"type": "string", "minLength": 1}, "focus_anchor": {"enum": ["CENTER", "SOURCE", "TARGET", "LABEL", "JUNCTION"]}, "expected_cells": {"type": "integer", "minimum": 1}, "golden_ref": {"$ref": "#/$defs/fileRef"}, "critical_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "expected_projection_sha256": {"$ref": "#/$defs/digest"}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["case_count", "capability_case_count", "common_case_count", "attempt_count", "capture_count", "attempt_capture_count", "pass_matched_count", "failed_count", "skipped_count", "retry_count"], "properties": {"case_count": {"const": 378}, "capability_case_count": {"const": 306}, "common_case_count": {"const": 72}, "attempt_count": {"const": 756}, "capture_count": {"const": 1242}, "attempt_capture_count": {"const": 2484}, "pass_matched_count": {"const": 0}, "failed_count": {"const": 0}, "skipped_count": {"const": 0}, "retry_count": {"const": 0}}}
  }
}
