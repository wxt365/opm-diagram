{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opm.local/contracts/opm-native-exchange-import-v1.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/projectCatalog"},
    {"$ref": "#/$defs/modelCatalog"},
    {"$ref": "#/$defs/modelHead"},
    {"$ref": "#/$defs/baseline"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projectCatalog": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "name", "normalized_name", "description", "status", "default_profile_id", "default_profile_version", "created_at", "updated_at"],
      "properties": {
        "project_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "normalized_name": {"type": "string", "minLength": 1}, "description": {"type": ["string", "null"]}, "status": {"const": "ACTIVE"}, "default_profile_id": {"$ref": "#/$defs/id"}, "default_profile_version": {"type": "string", "minLength": 1}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "modelCatalog": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "name", "normalized_name", "description", "status", "profile_binding", "created_at", "updated_at"],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "normalized_name": {"type": "string", "minLength": 1}, "description": {"type": ["string", "null"]}, "status": {"const": "ACTIVE"}, "profile_binding": {"type": "object"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "modelHead": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "draft_head_revision_id", "head_sequence", "updated_at"],
      "properties": {"model_id": {"$ref": "#/$defs/id"}, "draft_head_revision_id": {"$ref": "#/$defs/id"}, "head_sequence": {"type": "integer", "minimum": 1}, "updated_at": {"$ref": "#/$defs/timestamp"}}
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_id", "model_id", "revision_id", "name", "normalized_name", "description", "validation_report_digest", "evidence_summary", "created_at"],
      "properties": {"baseline_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "normalized_name": {"type": "string", "minLength": 1}, "description": {"type": ["string", "null"]}, "validation_report_digest": {"$ref": "#/$defs/digest"}, "evidence_summary": {"type": "object"}, "created_at": {"$ref": "#/$defs/timestamp"}}
    }
  }
}
