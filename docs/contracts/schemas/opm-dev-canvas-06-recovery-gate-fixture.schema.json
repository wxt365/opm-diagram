{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-recovery-gate-fixture:0.1",
  "title": "OPM DEV-CANVAS-06 Recovery Test-only Gate Fixture",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "fixture_id", "generated_at", "test_only", "production_loader_expected_status", "handoff_ref", "intake_report_ref", "source_build", "source_manifest_state", "enabled_capability_ids", "dependency_graph", "fixture_digest"],
  "properties": {"schema_id": {"const": "OPM-DEV-CANVAS-06-RECOVERY-GATE-FIXTURE-001"}, "schema_version": {"const": "0.1"}, "fixture_id": {"const": "RECOVERY-FIXTURE-GATE"}, "generated_at": {"type": "string", "format": "date-time"}, "test_only": {"const": true}, "production_loader_expected_status": {"const": "REJECTED"}, "handoff_ref": {"$ref": "#/$defs/fileRef"}, "intake_report_ref": {"$ref": "#/$defs/fileRef"}, "source_build": {"type": "object", "minProperties": 1}, "source_manifest_state": {"const": "ACTIVE_COMPLETE"}, "enabled_capability_ids": {"type": "array", "minItems": 34, "maxItems": 34, "uniqueItems": true, "items": {"pattern": "^CAP-ISO-(PROC|CTRL|STRUCT)-\\d{3}$"}}, "dependency_graph": {"type": "object", "additionalProperties": false, "required": ["edges", "sha256"], "properties": {"edges": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_capability_id", "dependent_capability_id", "evidence_ref"], "properties": {"source_capability_id": {"type": "string"}, "dependent_capability_id": {"type": "string"}, "evidence_ref": {"$ref": "#/$defs/fileRef"}}}}, "sha256": {"$ref": "#/$defs/digest"}}}, "fixture_digest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}}}
}
