  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "manifest_version", "generated_at", "generator_identity", "handoff_ref", "intake_report_ref", "upstream_source_build", "source_build", "environment_policy", "statistic_policy", "fixture_catalog", "scenario_catalog", "summary"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-PERFORMANCE-MANIFEST-001"}, "schema_version": {"const": "0.1"},
    "manifest_id": {"pattern": "^dev-canvas-06\\.performance\\.[a-f0-9]{12}\\.[a-f0-9]{12}$"}, "manifest_version": {"const": "0.1.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "generator_identity": {"$ref": "#/$defs/identity"}, "handoff_ref": {"$ref": "#/$defs/fileRef"}, "intake_report_ref": {"$ref": "#/$defs/fileRef"}, "upstream_source_build": {"type": "object", "minProperties": 1}, "source_build": {"$ref": "#/$defs/sourceBuild"},
    "environment_policy": {"$ref": "#/$defs/environmentPolicy"}, "statistic_policy": {"$ref": "#/$defs/statisticPolicy"}, "fixture_catalog": {"$ref": "#/$defs/fixtureCatalog"}, "scenario_catalog": {"$ref": "#/$defs/scenarioCatalog"}, "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["runner_version", "source_commit", "node_version", "os", "command", "runner_source_sha256"], "properties": {"runner_version": {"const": "0.1.0"}, "source_commit": {"pattern": "^[a-f0-9]{40}$"}, "node_version": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "runner_source_sha256": {"$ref": "#/$defs/digest"}}},
    "sourceBuild": {"type": "object", "additionalProperties": false, "required": ["source_commit", "dirty_before_build", "build_command", "node_version", "lockfile_sha256", "web_dist", "local_runtime_jar"], "properties": {"source_commit": {"pattern": "^[a-f0-9]{40}$"}, "dirty_before_build": {"const": false}, "build_command": {"type": "string", "minLength": 1}, "node_version": {"type": "string", "minLength": 1}, "lockfile_sha256": {"$ref": "#/$defs/digest"}, "web_dist": {"$ref": "#/$defs/fileRef"}, "local_runtime_jar": {"$ref": "#/$defs/fileRef"}}},
    "environmentPolicy": {"type": "object", "additionalProperties": false, "required": ["minimum_logical_cpu_count", "minimum_ram_bytes", "ssd_required", "browser_engine", "headful", "hardware_acceleration", "viewport", "device_scale_factor", "locale", "timezone", "hmr_enabled", "devtools_enabled", "throttling_enabled"], "properties": {"minimum_logical_cpu_count": {"const": 8}, "minimum_ram_bytes": {"const": 17179869184}, "ssd_required": {"const": true}, "browser_engine": {"const": "chromium"}, "headful": {"const": true}, "hardware_acceleration": {"const": true}, "viewport": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"const": 1440}, "height": {"const": 900}}}, "device_scale_factor": {"const": 1}, "locale": {"const": "zh-CN"}, "timezone": {"const": "Asia/Shanghai"}, "hmr_enabled": {"const": false}, "devtools_enabled": {"const": false}, "throttling_enabled": {"const": false}}},
    "statisticPolicy": {"type": "object", "additionalProperties": false, "required": ["unit", "percentile_method", "p50_rank", "p95_rank", "outlier_removal", "retry_allowed"], "properties": {"unit": {"const": "MICROSECONDS"}, "percentile_method": {"const": "NEAREST_RANK"}, "p50_rank": {"const": "ceil(0.50*N)-1"}, "p95_rank": {"const": "ceil(0.95*N)-1"}, "outlier_removal": {"const": false}, "retry_allowed": {"const": false}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "generator_id", "generator_version", "seed", "fixed_clock", "source_revision_ref", "context_count", "semantic_construct_count", "fact_count", "projection_junction_count", "cell_count", "capability_counts", "asset_binding", "artifact_refs", "fixture_digest", "expected_result_digests"], "properties": {"fixture_id": {"enum": ["PERF-FIXTURE-SMALL", "PERF-FIXTURE-OPD-300-600", "PERF-FIXTURE-OPD-1000-2000", "PERF-FIXTURE-MODEL-10000"]}, "generator_id": {"type": "string", "minLength": 1}, "generator_version": {"const": "0.1"}, "seed": {"const": "canvas06-performance-v1"}, "fixed_clock": {"type": "string", "format": "date-time"}, "source_revision_ref": {"$ref": "#/$defs/fileRef"}, "context_count": {"type": "integer", "minimum": 1}, "semantic_construct_count": {"type": "integer", "minimum": 1}, "fact_count": {"type": "integer", "minimum": 0}, "projection_junction_count": {"type": "integer", "minimum": 0}, "cell_count": {"type": "integer", "minimum": 1}, "capability_counts": {"type": "object", "minProperties": 1}, "asset_binding": {"type": "object", "minProperties": 1}, "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRef"}}, "fixture_digest": {"$ref": "#/$defs/digest"}, "expected_result_digests": {"type": "object", "minProperties": 1}}},
    "fixtureCatalog": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/fixture"}, "allOf": [{"contains": {"properties": {"fixture_id": {"const": "PERF-FIXTURE-SMALL"}}}}, {"contains": {"properties": {"fixture_id": {"const": "PERF-FIXTURE-OPD-300-600"}}}}, {"contains": {"properties": {"fixture_id": {"const": "PERF-FIXTURE-OPD-1000-2000"}}}}, {"contains": {"properties": {"fixture_id": {"const": "PERF-FIXTURE-MODEL-10000"}}}}]},
    "threshold": {"type": "object", "additionalProperties": false, "required": ["statistic", "operator", "limit_us"], "properties": {"statistic": {"enum": ["P95", "MAX", "EVERY_SAMPLE"]}, "operator": {"const": "LTE"}, "limit_us": {"type": "integer", "minimum": 1}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metric_id", "timing_domain", "unit", "measurement_method", "required_warmup_count", "threshold_policy"], "properties": {"metric_id": {"enum": ["EDIT_TOOL_SWITCH_US", "EDIT_SELECTION_US", "EDIT_INSPECTOR_FEEDBACK_US", "INCREMENTAL_OPL_VISIBLE_US", "PAN_ZOOM_FRAME_US", "SELECTION_FEEDBACK_US", "LARGE_MODEL_SAVE_US", "LARGE_MODEL_SNAPSHOT_US", "LARGE_MODEL_VALIDATE_US"]}, "timing_domain": {"enum": ["BROWSER_PERFORMANCE", "BROWSER_RAF", "NODE_HRTIME"]}, "unit": {"const": "MICROSECONDS"}, "measurement_method": {"type": "string", "minLength": 1}, "required_warmup_count": {"type": "integer", "minimum": 0}, "required_measured_count": {"type": "integer", "minimum": 1}, "required_measured_duration_us": {"type": "integer", "minimum": 1}, "minimum_measured_count": {"type": "integer", "minimum": 1}, "threshold_policy": {"$ref": "#/$defs/threshold"}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "fixture_id", "sample_set_path", "ordered_metrics", "functional_check_ids", "timeout_policy"], "properties": {"scenario_id": {"enum": ["PERF-CANVAS-001.EDIT_FEEDBACK", "PERF-CANVAS-002.INCREMENTAL_OPL", "PERF-CANVAS-003.BASELINE_OPD", "PERF-CANVAS-004.STRESS_OPD", "PERF-CANVAS-005.LARGE_MODEL_SAVE", "PERF-CANVAS-006.LARGE_MODEL_SNAPSHOT", "PERF-CANVAS-007.LARGE_MODEL_VALIDATE"]}, "fixture_id": {"type": "string", "minLength": 1}, "sample_set_path": {"$ref": "#/$defs/path"}, "ordered_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}}, "functional_check_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "timeout_policy": {"type": "object", "minProperties": 1}}},
    "scenarioCatalog": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/scenario"}, "allOf": [{"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-001.EDIT_FEEDBACK"}}}}, {"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-002.INCREMENTAL_OPL"}}}}, {"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-003.BASELINE_OPD"}}}}, {"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-004.STRESS_OPD"}}}}, {"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-005.LARGE_MODEL_SAVE"}}}}, {"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-006.LARGE_MODEL_SNAPSHOT"}}}}, {"contains": {"properties": {"scenario_id": {"const": "PERF-CANVAS-007.LARGE_MODEL_VALIDATE"}}}}]},
    "summary": {"type": "object", "additionalProperties": false, "required": ["fixture_count", "scenario_count", "metric_count", "raw_sample_set_count", "required_non_frame_measured_sample_count", "minimum_baseline_frame_sample_count", "minimum_stress_frame_sample_count", "minimum_total_measured_sample_count"], "properties": {"fixture_count": {"const": 4}, "scenario_count": {"const": 7}, "metric_count": {"const": 11}, "raw_sample_set_count": {"const": 7}, "required_non_frame_measured_sample_count": {"const": 615}, "minimum_baseline_frame_sample_count": {"const": 900}, "minimum_stress_frame_sample_count": {"const": 600}, "minimum_total_measured_sample_count": {"const": 2115}}}
  }
}
