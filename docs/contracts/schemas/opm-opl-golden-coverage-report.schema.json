{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:opl-golden-coverage-report:0.1",
  "title": "OPL Golden Coverage Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "status", "manifest", "catalog", "summary", "families", "missing", "unexpected", "mismatched"],
  "properties": {
    "schema_id": {"const": "OPL-GOLDEN-COVERAGE-REPORT-001"},
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["EXACT", "BLOCKED", "INVALID"]},
    "manifest": {"$ref": "#/$defs/asset"},
    "catalog": {"$ref": "#/$defs/asset"},
    "summary": {"$ref": "#/$defs/counts"},
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PROC", "CTRL", "STRUCT"],
      "properties": {"PROC": {"$ref": "#/$defs/family"}, "CTRL": {"$ref": "#/$defs/family"}, "STRUCT": {"$ref": "#/$defs/family"}}
    },
    "missing": {"type": "array", "items": {"type": "string"}},
    "unexpected": {"type": "array", "items": {"type": "string"}},
    "mismatched": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "matched", "missing", "unexpected", "mismatched"],
      "properties": {"expected": {"type": "integer", "minimum": 0}, "matched": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "unexpected": {"type": "integer", "minimum": 0}, "mismatched": {"type": "integer", "minimum": 0}}
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "BLOCKED"],
      "properties": {"PASS": {"$ref": "#/$defs/counts"}, "BLOCKED": {"$ref": "#/$defs/counts"}}
    }
  }
}
