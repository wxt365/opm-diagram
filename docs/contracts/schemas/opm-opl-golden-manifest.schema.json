{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:opl-golden-manifest:0.2",
  "title": "OPL Golden Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "manifest_version", "coverage_catalog_ref", "cases", "atomic_cases"],
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "manifest_version": {"type": "string", "minLength": 1},
    "coverage_catalog_ref": {"$ref": "#/$defs/coverageCatalogRef"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/goldenCase"}},
    "atomic_cases": {"type": "array", "minItems": 19, "maxItems": 19, "items": {"$ref": "#/$defs/atomicCase"}}
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stableId"}},
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "coverageCatalogRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "line", "source_marker", "target_marker", "junction_marker", "annotation", "completeness_annotation", "label_slots", "route_family"],
      "properties": {
        "symbol_id": {"$ref": "#/$defs/stableId"},
        "line": {"type": ["string", "null"]},
        "source_marker": {"type": ["string", "null"]},
        "target_marker": {"type": ["string", "null"]},
        "junction_marker": {"type": ["string", "null"]},
        "annotation": {"type": ["string", "null"]},
        "completeness_annotation": {"type": ["string", "null"]},
        "label_slots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "route_family": {"type": "string", "minLength": 1}
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence_id", "sentence_slot", "template_id", "ordinal", "utf8_text", "generation_rule_ids", "input_fact_ids", "tokens", "trace"],
      "properties": {
        "sentence_id": {"$ref": "#/$defs/stableId"},
        "sentence_slot": {"type": "string", "minLength": 1},
        "template_id": {"$ref": "#/$defs/stableId"},
        "ordinal": {"type": "integer", "minimum": 0},
        "utf8_text": {"type": "string", "minLength": 1},
        "generation_rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "input_fact_ids": {"$ref": "#/$defs/nonEmptyIds"},
        "tokens": {"type": "array", "minItems": 1, "items": {"$ref": "https://opm.local/schemas/opm-revision/0.2#/$defs/sentenceToken"}},
        "trace": {"$ref": "https://opm.local/schemas/opm-revision/0.2#/$defs/textTrace"}
      }
    },
    "expectedTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_delta", "revision_parent_delta", "text_artifact_delta", "text_trace_delta", "finding_delta", "operation_delta", "receipt_delta", "draft_head_changed"],
      "properties": {
        "revision_delta": {"const": 0},
        "revision_parent_delta": {"const": 0},
        "text_artifact_delta": {"const": 0},
        "text_trace_delta": {"const": 0},
        "finding_delta": {"const": 0},
        "operation_delta": {"const": 0},
        "receipt_delta": {"const": 0},
        "draft_head_changed": {"const": false}
      }
    },
    "goldenCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "capability_id", "variant_key", "expectation", "base_revision_fixture", "input_revision_fixture", "profile_ref", "rule_set_ref", "grammar_ref", "symbol_catalog_ref", "normalization_adapter_ref", "binding_digest"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^G-OPL-(PROC|CTRL|STRUCT)-[0-9]{3}\\.[A-Z][A-Z0-9_]*\\.(PASS|BLOCKED)$"},
        "capability_id": {"$ref": "#/$defs/stableId"},
        "base_fact_capability_id": {"$ref": "#/$defs/stableId"},
        "variant_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "expectation": {"enum": ["PASS", "BLOCKED"]},
        "base_revision_fixture": {"type": "string", "minLength": 1},
        "input_revision_fixture": {"type": "string", "minLength": 1},
        "profile_ref": {"$ref": "#/$defs/digestRef"},
        "rule_set_ref": {"$ref": "#/$defs/digestRef"},
        "grammar_ref": {"$ref": "#/$defs/digestRef"},
        "symbol_catalog_ref": {"$ref": "#/$defs/digestRef"},
        "normalization_adapter_ref": {"$ref": "#/$defs/digestRef"},
        "binding_digest": {"$ref": "#/$defs/digest"},
        "expected_normalized_fact": {"$ref": "https://opm.local/schemas/opm-revision/0.2#/$defs/fact"},
        "expected_projection": {"$ref": "#/$defs/projection"},
        "expected_sentences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sentence"}},
        "expected_artifact_sha256": {"$ref": "#/$defs/digest"},
        "expected_error_code": {"type": "string", "minLength": 1},
        "expected_transaction": {"$ref": "#/$defs/expectedTransaction"}
      },
      "allOf": [
        {"if": {"properties": {"expectation": {"const": "PASS"}}}, "then": {"required": ["expected_normalized_fact", "expected_projection", "expected_sentences", "expected_artifact_sha256"], "not": {"anyOf": [{"required": ["expected_error_code"]}, {"required": ["expected_transaction"]}]}}},
        {"if": {"properties": {"expectation": {"const": "BLOCKED"}}}, "then": {"required": ["expected_error_code", "expected_transaction"], "not": {"anyOf": [{"required": ["expected_normalized_fact"]}, {"required": ["expected_projection"]}, {"required": ["expected_sentences"]}, {"required": ["expected_artifact_sha256"]}]}}}
      ]
    },
    "atomicCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "category", "base_revision_fixture", "input_revision_fixture", "profile_ref", "rule_set_ref", "grammar_ref", "symbol_catalog_ref", "normalization_adapter_ref", "binding_digest", "fault", "expected_commit_code", "expected_error_code", "expected_transaction"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^G-OPL-ATOMIC-[0-9]{3}\\.[A-Z][A-Z0-9_]*\\.BLOCKED$"},
        "category": {"enum": ["PRODUCTION", "PROFILE_ASSEMBLY"]},
        "base_revision_fixture": {"type": "string", "minLength": 1},
        "input_revision_fixture": {"type": "string", "minLength": 1},
        "profile_ref": {"$ref": "#/$defs/digestRef"},
        "rule_set_ref": {"$ref": "#/$defs/digestRef"},
        "grammar_ref": {"$ref": "#/$defs/digestRef"},
        "symbol_catalog_ref": {"$ref": "#/$defs/digestRef"},
        "normalization_adapter_ref": {"$ref": "#/$defs/digestRef"},
        "binding_digest": {"$ref": "#/$defs/digest"},
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "mutation", "recompute_digests"],
          "properties": {
            "stage": {"enum": ["PRODUCTION_IDENTITY", "PRODUCTION_PLAN", "ASSET_PRESENCE", "ASSET_BYTES", "ASSET_IDENTITY", "CAPABILITY_BINDING", "REVISION_BINDING", "BINDING_DIGEST"]},
            "role": {"enum": ["RULE_SET", "SYMBOL_ASSET", "GRAMMAR_ASSET", "NORMALIZATION_DATA"]},
            "mutation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "recompute_digests": {"type": "boolean"}
          }
        },
        "expected_commit_code": {"const": "TEXT_GENERATION_BLOCKED"},
        "expected_error_code": {"type": "string", "minLength": 1},
        "expected_transaction": {"$ref": "#/$defs/expectedTransaction"}
      }
    }
  }
}
