{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opm:contract:dev-canvas-06-common-fixture-catalog:0.1",
  "title": "OPM DEV-CANVAS-06 Common Fixture Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "catalog_id", "catalog_version", "generated_at", "generator_ref", "source_binding", "visual_subjects", "e2e_cases", "summary"],
  "properties": {
    "schema_id": {"const": "OPM-DEV-CANVAS-06-COMMON-FIXTURE-CATALOG-001"},
    "schema_version": {"const": "0.1"},
    "catalog_id": {"pattern": "^dev-canvas-06\\.common-fixtures\\.[a-f0-9]{12}$"},
    "catalog_version": {"enum": ["0.1.0", "0.2.0"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator_ref": {"$ref": "#/$defs/fileRef"},
    "source_binding": {"$ref": "#/$defs/binding"},
    "visual_subjects": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [{"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "STATE_ROLES"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "LONG_LABELS"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "FUNDAMENTAL_FAN"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "CANDIDATE_LAYER"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "INSPECTOR"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "TOOLCHAIN_CATALOG"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "FINDING_FOCUS"}}}]}, {"allOf": [{"$ref": "#/$defs/visualSubject"}, {"properties": {"subject_id": {"const": "BLOCKED_FEEDBACK"}}}]}], "items": false},
    "e2e_cases": {"type": "array", "minItems": 16, "maxItems": 16, "prefixItems": [{"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-001.STATE_CREATE_RENAME_ROLES"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-001.STATE_EXPLICITNESS_EXPANSION"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-001.STATE_MOBILE_CREATE_REOPEN"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-001.STATE_TEXT_TRACE_ROUNDTRIP"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-005.REVERSE_DRAG_NORMALIZED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-005.AMBIGUOUS_OPTIONS_NOT_AUTOCOMMITTED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-005.STALE_OPTION_BLOCKED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-006.STATE_IMPACT_CONFIRMED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-006.FACT_IMPACT_CONFIRMED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-006.STALE_TOKEN_BLOCKED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-006.MISMATCHED_TOKEN_BLOCKED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-007.ASSET_MISSING"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-007.TEXT_BLOCKED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-007.REVISION_CONFLICT"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-007.PERSISTENCE_FAILED"}}}]}, {"allOf": [{"$ref": "#/$defs/e2eCase"}, {"properties": {"case_id": {"const": "E2E-CANVAS-007.READONLY"}}}]}], "items": false},
    "summary": {"type": "object", "additionalProperties": false, "required": ["visual_subject_count", "e2e_case_count"], "properties": {"visual_subject_count": {"const": 8}, "e2e_case_count": {"const": 16}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "byte_length", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["profile", "rule_set", "text_grammar", "symbol_catalog", "normalization_adapter", "binding_digest"], "properties": {"profile": {"$ref": "#/$defs/asset"}, "rule_set": {"$ref": "#/$defs/asset"}, "text_grammar": {"$ref": "#/$defs/asset"}, "symbol_catalog": {"$ref": "#/$defs/asset"}, "normalization_adapter": {"$ref": "#/$defs/asset"}, "binding_digest": {"$ref": "#/$defs/digest"}}},
    "visualSubject": {"type": "object", "additionalProperties": false, "required": ["subject_id", "factory_id", "factory_source_ref", "fixture_ref", "expected_revision", "focus_target_id", "focus_anchor", "expected_cells", "critical_regions"], "properties": {"subject_id": {"enum": ["STATE_ROLES", "LONG_LABELS", "FUNDAMENTAL_FAN", "CANDIDATE_LAYER", "INSPECTOR", "TOOLCHAIN_CATALOG", "FINDING_FOCUS", "BLOCKED_FEEDBACK"]}, "factory_id": {"type": "string", "minLength": 1}, "factory_source_ref": {"$ref": "#/$defs/fileRef"}, "fixture_ref": {"$ref": "#/$defs/fileRef"}, "expected_revision": {"type": "string", "minLength": 1}, "focus_target_id": {"type": "string", "minLength": 1}, "focus_anchor": {"enum": ["CENTER", "SOURCE", "TARGET", "LABEL", "JUNCTION"]}, "expected_cells": {"type": "integer", "minimum": 1}, "critical_regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criticalRegion"}}}},
    "criticalRegion": {"type": "object", "additionalProperties": false, "required": ["region_id", "kind"], "properties": {"region_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["MARKER", "LABEL", "JUNCTION", "NODE", "TOOLBAR", "INSPECTOR", "BOTTOM_PANEL", "CANVAS"]}}},
    "e2eCase": {"type": "object", "additionalProperties": false, "required": ["case_id", "factory_id", "factory_source_ref", "base_fixture_ref", "input_ref", "actions", "assertion_ids"], "properties": {"case_id": {"enum": ["E2E-CANVAS-001.STATE_CREATE_RENAME_ROLES", "E2E-CANVAS-001.STATE_EXPLICITNESS_EXPANSION", "E2E-CANVAS-001.STATE_MOBILE_CREATE_REOPEN", "E2E-CANVAS-001.STATE_TEXT_TRACE_ROUNDTRIP", "E2E-CANVAS-005.REVERSE_DRAG_NORMALIZED", "E2E-CANVAS-005.AMBIGUOUS_OPTIONS_NOT_AUTOCOMMITTED", "E2E-CANVAS-005.STALE_OPTION_BLOCKED", "E2E-CANVAS-006.STATE_IMPACT_CONFIRMED", "E2E-CANVAS-006.FACT_IMPACT_CONFIRMED", "E2E-CANVAS-006.STALE_TOKEN_BLOCKED", "E2E-CANVAS-006.MISMATCHED_TOKEN_BLOCKED", "E2E-CANVAS-007.ASSET_MISSING", "E2E-CANVAS-007.TEXT_BLOCKED", "E2E-CANVAS-007.REVISION_CONFLICT", "E2E-CANVAS-007.PERSISTENCE_FAILED", "E2E-CANVAS-007.READONLY"]}, "factory_id": {"type": "string", "minLength": 1}, "factory_source_ref": {"$ref": "#/$defs/fileRef"}, "base_fixture_ref": {"$ref": "#/$defs/fileRef"}, "input_ref": {"$ref": "#/$defs/fileRef"}, "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}}, "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["action_id", "expected_status", "expected_transaction", "reopen_checkpoint"], "properties": {"action_id": {"type": "string", "minLength": 1}, "expected_status": {"enum": ["PASS_MATCHED", "BLOCKED_MATCHED"]}, "expected_error_code": {"type": "string", "minLength": 1}, "expected_transaction": {"type": "object", "additionalProperties": false, "required": ["revision_delta", "revision_parent_delta", "text_artifact_delta", "text_trace_delta", "finding_delta", "operation_delta", "receipt_delta", "draft_head_changed"], "properties": {"revision_delta": {"type": "integer", "minimum": 0}, "revision_parent_delta": {"type": "integer", "minimum": 0}, "text_artifact_delta": {"type": "integer", "minimum": 0}, "text_trace_delta": {"type": "integer", "minimum": 0}, "finding_delta": {"type": "integer", "minimum": 0}, "operation_delta": {"type": "integer", "minimum": 0}, "receipt_delta": {"type": "integer", "minimum": 0}, "draft_head_changed": {"type": "boolean"}}}, "reopen_checkpoint": {"type": "object", "additionalProperties": false, "required": ["expected_head_changed", "projection_matches", "text_trace_matches"], "properties": {"expected_head_changed": {"type": "boolean"}, "projection_matches": {"type": "boolean"}, "text_trace_matches": {"type": "boolean"}}}}}
  }
}
