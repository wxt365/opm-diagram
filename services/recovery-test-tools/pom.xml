<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.opm</groupId>
        <artifactId>opm-modeling-tool</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>recovery-test-tools</artifactId>
    <name>OPM Recovery Test Tools</name>

    <properties>
        <opm.recovery.sourceCommit>UNSET</opm.recovery.sourceCommit>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.opm</groupId>
            <artifactId>local-runtime</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                        <manifestEntries>
                            <Implementation-Title>OPM Recovery Test Tools</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <OPM-Recovery-Contract-Version>0.1.0</OPM-Recovery-Contract-Version>
                            <OPM-Source-Commit>${opm.recovery.sourceCommit}</OPM-Source-Commit>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
