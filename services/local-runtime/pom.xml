<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.opm</groupId>
        <artifactId>opm-modeling-tool</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>local-runtime</artifactId>
    <name>OPM Local Runtime</name>

    <properties>
        <opm.recovery.helper-build>false</opm.recovery.helper-build>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../../docs/contracts/migrations/sqlite</directory>
                <targetPath>db/migration</targetPath>
                <includes>
                    <include>V*__*.sql</include>
                </includes>
            </resource>
            <resource>
                <directory>../../docs/contracts/migrations/sqlite/hybrid-save</directory>
                <targetPath>db/hybrid-save</targetPath>
                <includes><include>V3__hybrid_save_foundation.sql</include></includes>
            </resource>
            <resource>
                <directory>../../docs/contracts/migrations/sqlite-checkpoint</directory>
                <targetPath>db/checkpoint</targetPath>
                <includes><include>V4__checkpoint_capture_overlay.sql</include></includes>
            </resource>
            <resource>
                <directory>../../docs/contracts/migrations/sqlite-pin</directory>
                <targetPath>db/pin</targetPath>
                <includes><include>V5__pin_retention_nullable_sequence.sql</include></includes>
            </resource>
            <resource>
                <directory>../../docs/contracts/schemas</directory>
                <targetPath>releaseevidence/schema</targetPath>
                <includes>
                    <include>opm-dev-canvas-06-e2e-attempt-artifact-v02.schema.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>${opm.recovery.helper-build}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>recovery-helper-build</id>
            <activation>
                <property>
                    <name>opm.recovery.sourceCommit</name>
                </property>
            </activation>
            <properties>
                <opm.recovery.helper-build>true</opm.recovery.helper-build>
            </properties>
        </profile>
    </profiles>
</project>
