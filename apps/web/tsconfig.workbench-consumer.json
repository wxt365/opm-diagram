{
  "include": ["examples/workbench-consumer.ts"],
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": false,
    "paths": {
      "@opm/workbench": ["./dist-workbench/types/workbench/index.d.ts"],
      "@opm/workbench/runtime": ["./dist-workbench/types/workbench/localRuntimeServices.d.ts"]
    }
  }
}
