DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# deepseek 使用 Messages；openai 使用 OpenAI 兼容 Chat Completions。
OPM_MODEL_PROVIDER=deepseek
# 仅受信任私网 HTTP 服务可显式许可，必须精确匹配 origin（无路径/末尾斜杠）。
# HTTP 会明文传输 Key 与模型资料，优先使用 HTTPS。
# OPM_MODEL_HTTP_ORIGIN=http://192.168.1.10:8080
OPM_RUNTIME_ORIGIN=http://127.0.0.1:17850
OPM_ASSISTANT_PORT=17860
# 局域网访问时，与 Runtime 配置同一份页面来源；多个来源使用逗号分隔。
# OPM_TRUSTED_WEB_ORIGINS=http://192.168.2.182:5177
# 默认写入仓库 runtime-data/assistant，可指定独立目录。
# OPM_ASSISTANT_DATA=/absolute/path/to/assistant-data
