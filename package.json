{
  "name": "opm-modeling-tool",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "golden:proc:blocked": "node scripts/author-opl-procedural-blocked-fixtures.mjs --write",
    "golden:proc:blocked:check": "node scripts/author-opl-procedural-blocked-fixtures.mjs",
    "golden:proc:pass": "node scripts/author-opl-procedural-pass-fixtures.mjs --write && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplProceduralPassGoldenAuthorCli -Dspring-boot.run.arguments=--write",
    "golden:proc:pass:check": "node scripts/author-opl-procedural-pass-fixtures.mjs && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplProceduralPassGoldenAuthorCli",
    "golden:ctrl:pass": "node scripts/author-opl-control-pass-fixtures.mjs --write && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplProceduralPassGoldenAuthorCli -Dspring-boot.run.arguments='--write --control'",
    "golden:ctrl:pass:check": "node scripts/author-opl-control-pass-fixtures.mjs && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplProceduralPassGoldenAuthorCli -Dspring-boot.run.arguments=--control",
    "golden:struct:pass": "node scripts/author-opl-structural-fixtures.mjs --write && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplProceduralPassGoldenAuthorCli -Dspring-boot.run.arguments='--write --structural'",
    "golden:struct:pass:check": "node scripts/author-opl-structural-fixtures.mjs && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplProceduralPassGoldenAuthorCli -Dspring-boot.run.arguments=--structural",
    "golden:struct:blocked": "node scripts/author-opl-structural-fixtures.mjs --write && node scripts/author-opl-structural-blocked-fixtures.mjs --write",
    "golden:struct:blocked:check": "node scripts/author-opl-structural-fixtures.mjs && node scripts/author-opl-structural-blocked-fixtures.mjs",
    "golden:ctrl:blocked": "node scripts/author-opl-control-blocked-fixtures.mjs --write",
    "golden:ctrl:blocked:check": "node scripts/author-opl-control-blocked-fixtures.mjs",
    "golden:ctrl": "npm run golden:ctrl:blocked && npm run golden:ctrl:pass",
    "golden:ctrl:check": "npm run golden:ctrl:pass:check && npm run golden:ctrl:blocked:check",
    "contract:generate": "node scripts/generate-api-edt-contracts.mjs",
    "contract:check": "node scripts/generate-api-edt-contracts.mjs --check",
    "contract:validate": "npm run contract:check && node scripts/validate-contracts.mjs",
    "golden:check": "node scripts/validate-opl-golden-manifest.mjs packages/profiles/profile.iso19450.2024.draft/0.2.0/golden/opm-opl-golden-manifest.json",
    "golden:contract:test": "node --test scripts/validate-opl-golden-manifest.test.mjs",
    "golden:replay": "npm run golden:check && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.golden.OplGoldenReplayCli -Dspring-boot.run.arguments='--manifest packages/profiles/profile.iso19450.2024.draft/0.2.0/golden/opm-opl-golden-manifest.json --report services/local-runtime/target/golden-replay/opm-opl-golden-replay-report.json' && node scripts/validate-opl-golden-replay-report.mjs services/local-runtime/target/golden-replay/opm-opl-golden-replay-report.json && node scripts/validate-opl-golden-committed-revisions.mjs --manifest packages/profiles/profile.iso19450.2024.draft/0.2.0/golden/opm-opl-golden-manifest.json --work-root services/local-runtime/target/golden-replay/work",
    "golden:coverage": "npm run golden:check -- --coverage",
    "compatibility:check": "node scripts/author-revision-compatibility-fixtures.mjs && node scripts/validate-revision-compatibility-manifest.mjs",
    "compatibility:replay": "npm run compatibility:check && ./mvnw -o -pl services/local-runtime spring-boot:run -Dspring-boot.run.main-class=org.opm.localruntime.compatibility.RevisionCompatibilityCli -Dspring-boot.run.arguments='--manifest packages/profiles/profile.iso19450.2024.draft/0.2.0/golden/compatibility/opm-revision-compatibility-manifest.json --report services/local-runtime/target/compatibility-replay/opm-revision-compatibility-report.json'",
    "handoff:evidence": "node scripts/generate-dev-canvas-05-gate-evidence-reports.mjs && node scripts/validate-dev-canvas-05-gate-evidence-report.mjs services/local-runtime/target/golden-contract/opm-opl-golden-contract-report.json && node scripts/validate-dev-canvas-05-gate-evidence-report.mjs services/local-runtime/target/trace-closure/opm-opl-trace-closure-report.json",
    "handoff:contract:test": "node --test scripts/validate-dev-canvas-05-handoff.test.mjs",
    "handoff:release": "node scripts/build-dev-canvas-05-release.mjs",
    "handoff:check": "npm run handoff:evidence && node scripts/generate-dev-canvas-05-handoff.mjs && node scripts/validate-dev-canvas-05-handoff.mjs packages/profiles/profile.iso19450.2024.draft/0.2.0/handoff/dev-canvas-05-handoff.json",
    "lint": "npm run lint --workspace=@opm/web",
    "typecheck": "npm run typecheck --workspace=@opm/web",
    "test": "npm run contract:validate && npm run test --workspace=@opm/web",
    "build": "npm run contract:validate && npm run build --workspace=@opm/web",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "backend:verify": "./mvnw verify"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@playwright/test": "1.57.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
